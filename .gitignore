# --- Runtime / per-machine state --------------------------------------------
# Saved Highbyte connection info (URL + username + mode). User-specific.
connection.json

# Locally-fetched forecast cache. Regenerated by the app on every refresh.
weather_data.json

# --- Generated documentation artifacts --------------------------------------
# Intermediate HTML produced by MdToHtml.exe from README.md.
README.html

# --- Test / verification screenshots ----------------------------------------
# Anything generated during automated screenshotting. We keep `screenshot.png`
# because README.md embeds it as the hero image.
screenshot_*.png
crop_*.png
login_*.png
post_login_*.png
*_preview.png
section*_preview.png
toolbar_check*.png

# --- One-off PDF exports produced during testing ----------------------------
# (Output of the in-app "Export PDF" feature exercised in PowerShell.)
sample_chart_export.pdf
WeatherPlot_*.pdf

# --- Build artifacts --------------------------------------------------------
*.pdb
bin/
obj/

# --- Logs -------------------------------------------------------------------
*.log
